# =============================================================================
#  Configuration de l'agent de veille GRC
#  1. Copier ce fichier :  cp .env.example .env   (Windows : copy .env.example .env)
#  2. Remplir SES propres valeurs dans .env
#  3. Ne jamais publier le fichier .env (il est exclu par .gitignore)
# =============================================================================

# --- Modèle d'IA ------------------------------------------------------------
# mock    = démo hors ligne, aucune clé (réponses enregistrées dans data/demo)
# google  = Gemini, offre gratuite : clé sur https://aistudio.google.com/apikey
# mistral = Mistral, offre gratuite « Experiment » : clé sur https://console.mistral.ai/api-keys
LLM_PROVIDER=mock
# Laisser vide pour le modèle par défaut (gemini-3.8-flash / mistral-small-latest)
LLM_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
# Pause entre deux appels (ms) : les offres gratuites limitent le nombre de requêtes par minute
LLM_DELAY_MS=4000

# --- Stockage ------------------------------------------------------------------
# local  = data/store.json (démo)
# notion = bases Notion (voir README, étape « Notion »)
STORAGE=local

# --- Notion ----------------------------------------------------------------------
# Secret de l'intégration : https://www.notion.so/profile/integrations → « Internal Integration Secret »
NOTION_TOKEN=
# Lien (ou identifiant) d'une page Notion vide, partagée avec l'intégration
NOTION_PARENT_PAGE_ID=
# Remplis automatiquement par `npm run notion:setup`
NOTION_DB_TEXTES=
NOTION_DB_EXIGENCES=
NOTION_DB_CONTROLES=
NOTION_DB_RISQUES=
NOTION_DB_JURISPRUDENCE=
NOTION_DB_LOTS=

# --- PISTE : Légifrance + Judilibre (optionnel) ---------------------------------
# Compte gratuit sur https://piste.gouv.fr → application → activer Légifrance et JUDILIBRE
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
PISTE_SANDBOX=false

# --- Organisation analysée -------------------------------------------------------
ORGANISATION_FILE=data/organisation/hydrea.json
